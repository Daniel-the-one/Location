# Copier ce fichier en .env puis adapter les valeurs.
DEBUG=True
SECRET_KEY=change-me-en-production
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL local (MySQL Server 8.0). Créer la base avant :
#   CREATE DATABASE essivivi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:motdepasse@127.0.0.1:3306/essivivi

# Origines autorisées pour l'application Flutter web
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# URL de l'application Flutter (liens dans les emails)
FRONTEND_URL=http://localhost:5000

# Emails : console en dev, SMTP en production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@essivivi.local
